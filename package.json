{
    "name": "edit_me",
    "private": true,
    "version": "???",
    "description": "",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build:website": "bun run --sequential clean-dist clean-docs prepare && bun run scripts/build-website.ts",
        "dev": "bun run --parallel \"dev:*\"",
        "dev:serve": "python3 -m http.server -d docs",
        "dev:watch": "bun nodemon -e js,json,ts,css,md,html -i docs -w src -w website -w scripts --exec \"bun run build:website\"",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "prepare": "bun run build --minify",
        "clean-dist": "rm -rf dist/*",
        "clean-docs": "rm -rf docs/*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/bun-typescript-template.git"
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "@types/markdown-it": "^14.1.2",
        "@types/markdown-it-attrs": "^4.1.3",
        "@types/node": "^25.6.0",
        "@types/prismjs": "^1.26.6",
        "markdown-it": "^14.1.1",
        "markdown-it-attrs": "^4.3.1",
        "node-html-parser": "^7.1.0",
        "nodemon": "^3.1.14",
        "prismjs": "^1.30.0"
    }
}